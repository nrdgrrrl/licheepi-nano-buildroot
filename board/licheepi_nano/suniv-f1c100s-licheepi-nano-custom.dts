// Board-specific overrides for the upstream Linux 6.18 F1C100S Nano DTS.
/*
 * Copyright 2018 Icenowy Zheng <icenowy@aosc.io>
 */

/dts-v1/;
#include "allwinner/suniv-f1c100s-licheepi-nano.dts"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "Linux Business Card";

	/*
	 * PC1 (F1C physical pin 60) is the power-hold signal. The gpio-poweroff
	 * driver requests logical inactive at probe; with ACTIVE_LOW this keeps
	 * the physical line HIGH during normal runtime and drives it LOW on
	 * final poweroff.
	 */
	poweroff {
		compatible = "gpio-poweroff";
		gpios = <&pio 2 1 GPIO_ACTIVE_LOW>; /* PC1 */
	};

	gpio_keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		/* Configure the unclaimed ESP reset line as input at boot too. */
		pinctrl-0 = <&esp_reset_pd15>;

		button-1 {
			label = "Button 1";
			linux,code = <KEY_F1>;
			gpios = <&pio 3 1 GPIO_ACTIVE_LOW>; /* PD1 */
			debounce-interval = <20>;
		};

		button-2 {
			label = "Button 2";
			linux,code = <KEY_F2>;
			gpios = <&pio 3 2 GPIO_ACTIVE_LOW>; /* PD2 */
			debounce-interval = <20>;
		};

		button-3 {
			label = "Button 3";
			linux,code = <KEY_F3>;
			gpios = <&pio 3 3 GPIO_ACTIVE_LOW>; /* PD3 */
			debounce-interval = <20>;
		};

		button-4 {
			label = "Button 4";
			linux,code = <KEY_F4>;
			gpios = <&pio 3 4 GPIO_ACTIVE_LOW>; /* PD4 */
			debounce-interval = <20>;
		};
	};

};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	/delete-property/ usb0_id_det-gpios;
	status = "okay";
};

/* The handheld boots from SD and does not use the inherited W25Q128 SPI flash. */
&spi0 {
	status = "disabled";
};

&pio {
	i2c0_pe_pins: i2c0-pe-pins {
		pins = "PE11", "PE12";
		function = "i2c0";
	};

	uart2_pd_pins: uart2-pd-pins {
		pins = "PD13", "PD14";
		function = "uart2";
	};

	esp_reset_pd15: esp-reset-pd15 {
		pins = "PD15";
		function = "gpio_in";
		bias-disable;
	};

};

/* TWI0 uses PE11/PE12 for the userspace TCA9535 at address 0x20. */
&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pe_pins>;
	status = "okay";

	/* XFP1116-07A: the SH1106 exposes 132 RAM columns, but this module
	 * exposes the centered 128 columns starting at controller column 2. */
	oled@3c {
		compatible = "sinowealth,sh1106";
		reg = <0x3c>;
		solomon,width = <128>;
		solomon,height = <64>;
		solomon,col-offset = <2>;
	};
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pd_pins>;
	status = "okay";
};

&{/aliases} {
	serial2 = &uart2;
};

