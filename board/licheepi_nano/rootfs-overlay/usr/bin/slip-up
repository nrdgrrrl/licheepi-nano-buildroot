#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
	echo "Usage: $0 UART_DEVICE" >&2
	exit 2
fi

UART=$1
PIDFILE=/run/slip-ttyS2.pid

# Keep the helper safe to invoke manually as well as from the init script.
# BusyBox's pidof is used so repeated starts cannot create another slattach.
slattach_pid=""
if [ -r "$PIDFILE" ]; then
	pid=$(cat "$PIDFILE")
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		slattach_pid=$pid
	else
		rm -f "$PIDFILE"
	fi
fi

if [ -z "$slattach_pid" ]; then
	existing_pid=$(pidof slattach 2>/dev/null || true)
	if [ -n "$existing_pid" ]; then
		slattach_pid=$existing_pid
		echo "$slattach_pid" > "$PIDFILE"
	fi
fi

if [ -z "$slattach_pid" ]; then
	slattach -L -p slip -s 115200 "$UART" &
	slattach_pid=$!
	echo "$slattach_pid" > "$PIDFILE"
fi

# slattach creates sl0 asynchronously. Keep startup bounded if the UART or
# ESP8266 is unavailable; the init script may make a small number of retries.
tries=0
while ! ifconfig sl0 >/dev/null 2>&1; do
	tries=$((tries + 1))
	if [ "$tries" -ge 20 ]; then
		echo "SLIP interface did not appear" >&2
		exit 1
	fi
	sleep 0.1
done

ifconfig sl0 192.168.240.2 pointopoint 192.168.240.1 up mtu 1500
route add default gw 192.168.240.1 2>/dev/null || true
printf '%s\n' 'nameserver 9.9.9.9' > /etc/resolv.conf
